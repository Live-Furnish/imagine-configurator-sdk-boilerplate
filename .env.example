# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit a real key.

# Your organisation's API key, from the admin panel → Settings → API Keys.
VITE_API_KEY=ck_replace_me

# Which configurable system to load. Admin panel → Configurable Systems → the id
# in the URL (…/configurable-systems/2 → VITE_SYSTEM_ID=2).
VITE_SYSTEM_ID=1
